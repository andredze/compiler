DED_FLAGS = -D _DEBUG -ggdb3 -std=c++17 -Wall -Wextra -Weffc++ -Wsign-conversion 			 	 \
		   -Waggressive-loop-optimizations -Wc++14-compat -Wmissing-declarations 		   		 \
		   -Wcast-align -Wcast-qual -Wchar-subscripts -Wconditionally-supported  		   		 \
		    -Wctor-dtor-privacy -Wempty-body -Wfloat-equal -Wformat-nonliteral 		 			 \
		   -Wformat-security -Wformat-signedness -Wformat=2 -Winline -Wlogical-op 		   		 \
		   -Wnon-virtual-dtor -Wopenmp-simd -Woverloaded-virtual -Wpacked -Wpointer-arith  		 \
		   -Winit-self -Wredundant-decls -Wshadow -Wsign-promo		   		 					 \
		   -Wstrict-null-sentinel -Wstrict-overflow=2 -Wsuggest-attribute=noreturn		   		 \
		   -Wsuggest-final-methods -Wsuggest-final-types -Wsuggest-override -Wswitch-default 	 \
		   -Wswitch-enum -Wsync-nand -Wundef -Wunreachable-code -Wunused -Wuseless-cast 		 \
		   -Wvariadic-macros -Wno-literal-suffix -Wno-missing-field-initializers -Wno-narrowing  \
		   -Wno-old-style-cast -Wno-varargs -Wstack-protector -fcheck-new -fsized-deallocation 	 \
		   -fstack-protector -fstrict-overflow -flto-odr-type-merging -fno-omit-frame-pointer 	 \
		   -Wlarger-than=8192 -Wstack-usage=8192 -pie -fPIE -Werror=vla -Wconversion

ASAN = -fsanitize=address,alignment,bool,bounds,enum,float-cast-overflow,$\
	    float-divide-by-zero,integer-divide-by-zero,leak,nonnull-attribute,$\
	    null,object-size,return,returns-nonnull-attribute,shift,signed-integer-overflow,$\
	    undefined,unreachable,vla-bound,vptr

CXX = g++

# ——————————————————————————————————————————————————————————————————————————————————————————

ifdef DEBUG
	CXXFLAGS += $(DED_FLAGS) $(ASAN) -D TREE_DEBUG -D STACK_DEBUG -D DEBUG -D FUNC_BT_DEBUG -D BACKEND_DEBUG
else
	CXXFLAGS += -O3 -flto -D NDEBUG -march=native
endif

ifdef TEST_DSL
	CXXFLAGS += -D TEST_DSL
endif

ifdef ENCODING
	CXXFLAGS += -D ENCODING_DEBUG
endif

# ——————————————————————————————————————————————————————————————————————————————————————————

BACKEND_INCLUDES  := -D BACKEND 		\
					 -I backend/include \
                     -I common/lang_ctx \
                     -I common/stack 	\
                     -I common/colors 	\
                     -I common/tree 	\
                     -I common/io_file 	\
                     -I common/AST_io 	\
                     -I common

BACKEND_SOURCES := backend/src/main.cpp 			 			\
                   backend/src/backend.cpp 			 			\
                   backend/src/emission.cpp 		 			\
                   backend/src/relocations_table.cpp 			\
                   backend/src/testing.cpp 			 			\
                   backend/src/instruction.cpp 		 			\
                   backend/src/bin_code_buffer.cpp 	 			\
                   backend/src/elf_build.cpp 		 			\
                   backend/src/elf_build_header.cpp	 			\
                   backend/src/elf_build_string_table.cpp 		\
                   backend/src/elf_build_symbol_table.cpp 		\
                   backend/src/elf_build_relocation_table.cpp 	\
                   backend/src/encoding_x86.cpp 	 			\
                   backend/src/assembly_nasm.cpp 	 			\
                   common/lang_ctx/lang_funcs.cpp 	 			\
                   common/stack/stack.cpp 			 			\
                   common/AST_io/AST_read.cpp 		 			\
                   common/tree/tree_commands.cpp 	 			\
                   common/tree/tree_dump.cpp 		 			\
                   common/colors/colors.cpp 		 			\
                   common/io_file/io_file.cpp

LOGS := log/*

BACKEND_TARGET := back

# ——————————————————————————————————————————————————————————————————————————————————————————

OBJ_DIR := obj

BACKEND_OBJECTS := $(addprefix $(OBJ_DIR)/, $(BACKEND_SOURCES:.cpp=.o))

OBJ_DIRS := $(sort $(dir $(BACKEND_OBJECTS)))

# ==========================================================================================

all: $(BACKEND_TARGET)

$(OBJ_DIRS):
	mkdir -p $@

# ——————————————————————————————————————————————————————————————————————————————————————————

$(OBJ_DIR)/%.o: %.cpp | $(OBJ_DIRS)
	$(CXX) $(CXXFLAGS) $(BACKEND_INCLUDES) -c $< -o $@

# ——————————————————————————————————————————————————————————————————————————————————————————

$(BACKEND_TARGET): $(BACKEND_OBJECTS)
	$(CXX) $(CXXFLAGS) $^ -o $@

# ——————————————————————————————————————————————————————————————————————————————————————————

clean:
	rm -rf $(OBJ_DIR) $(FRONTEND_TARGET) $(LOGS)

.PHONY: all clean

# ——————————————————————————————————————————————————————————————————————————————————————————
